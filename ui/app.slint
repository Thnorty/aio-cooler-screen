import { Button, ComboBox, Switch, Slider, Spinner, ScrollView, Palette, AboutSlint, LineEdit, CheckBox, ProgressIndicator } from "std-widgets.slint";

export struct StatRow {
    title: string,
    choices: [string],
    index: int,
    value: string,
}

// ---------------------------------------------------------------------------------------------
// Building blocks

component Glyph inherits Text {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    vertical-alignment: center;
    horizontal-alignment: center;
    color: Palette.foreground;
}

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 40px;
    border-radius: 6px;
    background: root.selected ? #8080802a : ta.has-hover ? #80808018 : transparent;
    animate background { duration: 120ms; }
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 18px : 0px;
        border-radius: 1.5px;
        background: Palette.accent-background;
        animate height { duration: 150ms; }
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 14px;
        Glyph { text: root.glyph; width: 20px; }
        Text {
            text: root.text;
            font-size: 14px;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: Palette.control-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: #80808030;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        if root.title != "": VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 600;
                color: Palette.foreground;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 12px;
                color: Palette.foreground;
                opacity: 0.7;
                wrap: word-wrap;
            }
        }
        @children
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    min-height: 36px;
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.label;
                font-size: 13px;
                color: Palette.foreground;
            }
            if root.hint != "": Text {
                text: root.hint;
                font-size: 11px;
                color: Palette.foreground;
                opacity: 0.65;
                wrap: word-wrap;
            }
        }
        @children
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: #80808026;
}

component Swatches inherits Rectangle {
    in property <[color]> colors;
    in-out property <int> selected;
    callback picked(int);
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        for c[i] in root.colors: Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 13px;
            background: c;
            border-width: root.selected == i ? 3px : 1px;
            border-color: root.selected == i ? Palette.accent-background : #80808070;
            TouchArea {
                clicked => {
                    root.selected = i;
                    root.picked(i);
                }
            }
        }
    }
}

// A round thumbnail with a caption, used for designs and backgrounds.
component RoundTile inherits Rectangle {
    in property <image> thumb;
    in property <string> name;
    in property <bool> selected;
    callback clicked;
    width: 112px;
    height: 150px;
    border-radius: 8px;
    background: root.selected ? #8080801f : ta.has-hover ? #80808014 : transparent;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.accent-background : #80808030;
    animate background { duration: 120ms; }
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 92px;
                height: 92px;
                border-radius: 46px;
                clip: true;
                background: #000000;
                Image {
                    source: root.thumb;
                    width: 92px;
                    height: 92px;
                }
            }
        }
        Text {
            text: root.name;
            horizontal-alignment: center;
            font-size: 12px;
            color: Palette.foreground;
            wrap: word-wrap;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component NewDesignTile inherits Rectangle {
    in property <int> language;
    callback clicked;
    width: 112px;
    height: 150px;
    border-radius: 8px;
    background: ta.has-hover ? #80808014 : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? Palette.accent-background : #80808050;
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        Glyph {
            text: "\u{E710}";
            font-size: 28px;
        }
        Text {
            text: root.language == 1 ? ("Yeni tasarım") : ("New design");
            horizontal-alignment: center;
            font-size: 12px;
            color: Palette.foreground;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    padding-bottom: 4px;
    Text {
        text: root.title;
        font-size: 28px;
        font-weight: 600;
        color: Palette.foreground;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: 13px;
        color: Palette.foreground;
        opacity: 0.7;
        wrap: word-wrap;
    }
}

component InfoBar inherits Rectangle {
    in property <string> text;
    in property <bool> ok;
    in property <bool> warning;
    border-radius: 6px;
    background: root.ok ? #22c55e26 : root.warning ? #f59e0b26 : #ef444426;
    border-width: 1px;
    border-color: root.ok ? #22c55e66 : root.warning ? #f59e0b66 : #ef444466;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Glyph {
            text: root.ok ? "\u{E73E}" : "\u{E7BA}";
            color: root.ok ? #22c55e : root.warning ? #f59e0b : #ef4444;
            width: 18px;
        }
        Text {
            text: root.text;
            wrap: word-wrap;
            font-size: 13px;
            color: Palette.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        @children
    }
}

component InfoLine inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> text;
    spacing: 10px;
    Glyph {
        text: root.glyph;
        font-size: 14px;
        width: 18px;
        opacity: 0.75;
    }
    Text {
        text: root.text;
        font-size: 12px;
        color: Palette.foreground;
        opacity: 0.85;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

// ---------------------------------------------------------------------------------------------
// Window

export component AppWindow inherits Window {
    title: "AIO Cooler Screen";
    // Embedded at compile time: Slint 1.18 never applies a window icon made at runtime
    // (Image::from_rgba8 has no cache key, so the backend thinks the icon is unchanged).
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 1180px;
    min-height: 660px;
    background: Palette.background;
    default-font-family: "Segoe UI Variable Text";

    in property <image> app-icon;
    in property <string> version;
    in-out property <int> language: 0; // 0 English, 1 Turkish
    callback language-changed(int);
    in-out property <int> page: 0;

    // Preview (Background and Design pages)
    in property <image> preview;
    in property <bool> preview-live;
    in-out property <int> preview-shape: 0; // 0 = square, 1 = round
    in property <bool> official-running;
    in property <bool> sensors-ok;

    // Background page
    in property <[image]> bg-thumbs;
    in property <[string]> bg-names;
    in property <int> bg-selected: -1;
    in property <string> media-name;
    in-out property <string> source-path;
    in property <bool> source-is-video;
    in-out property <int> fit;
    in property <bool> busy;
    in property <string> busy-text;
    in property <string> message;
    in property <bool> message-ok;

    // Design page
    in property <[image]> design-thumbs;
    in property <[string]> design-names;
    in property <int> design;
    in-out property <bool> stats-enabled;
    in property <[color]> swatches;

    // Style of the selected design
    in-out property <int> text-color-index;
    in-out property <int> accent-index;
    in-out property <bool> temp-colors;
    in-out property <float> dim;
    in-out property <int> font-index;
    in-out property <float> text-scale;
    in-out property <bool> outline;

    // Built-in design options
    in-out property <bool> g-load-rings;
    in-out property <bool> g-labels;
    in-out property <float> g-thickness;
    in-out property <bool> t-cpu-temp;
    in-out property <bool> t-cpu-load;
    in-out property <bool> t-gpu-temp;
    in-out property <bool> t-gpu-load;
    in-out property <int> t-columns;
    in-out property <int> t-position;
    in-out property <bool> t-panel;
    in-out property <float> t-panel-opacity;
    in-out property <int> b-stat;
    in-out property <bool> b-ring;
    in-out property <bool> b-ticks;
    in-out property <bool> b-secondary;
    in-out property <bool> c-h24;
    in-out property <bool> c-seconds;
    in-out property <bool> c-date;
    in-out property <int> c-stats;

    // Custom design editor
    in-out property <string> custom-name;
    in-out property <bool> cu-h24;
    in property <[string]> widget-kinds;
    in-out property <int> add-kind;
    in property <[string]> widget-names;
    in property <int> selected-widget: -1;
    in property <string> w-kind-name;
    in property <bool> w-uses-stat;
    in property <bool> w-is-text;
    in property <bool> w-is-label;
    in property <bool> w-has-thickness;
    in property <string> w-size-label;
    in property <float> w-size-min: 8;
    in property <float> w-size-max: 480;
    in-out property <int> w-stat;
    in property <[string]> widget-sensor-choices;
    in-out property <float> w-sensor-max: 100;
    in-out property <string> w-text;
    in-out property <float> w-size;
    in-out property <float> w-thickness;
    in-out property <float> w-x;
    in-out property <float> w-y;
    in-out property <bool> w-bold;
    in-out property <bool> w-auto;
    in-out property <int> w-color-index;

    // Sensors page
    in property <[StatRow]> stat-rows;
    in property <string> sensors-state;
    in-out property <string> lhm-port;

    // Settings page
    in property <string> service-state;
    in property <bool> service-running;
    in property <bool> cooler-ok;
    in property <string> cooler-state;
    in property <string> last-error;
    in property <bool> ffmpeg-ok;
    in property <string> ffmpeg-state;
    in property <bool> ffmpeg-busy;
    in property <float> ffmpeg-progress;
    in-out property <bool> autostart;
    in property <bool> autostart-busy;
    in-out property <bool> show-tray;
    in-out property <bool> login-tray;
    in property <bool> display-off;

    callback builtin-background(int);
    callback browse();
    callback apply-media();
    callback design-selected(int);
    callback new-design();
    callback duplicate-design();
    callback delete-design();
    callback add-widget(int);
    callback widget-selected(int);
    callback widget-changed();
    callback move-widget(int);
    callback delete-widget();
    callback preview-pressed(float, float);
    callback preview-dragged(float, float);
    callback preview-released();
    callback preview-shape-changed(int);
    callback settings-changed();
    callback source-selected(int, int);
    callback repair-service();
    callback open-data-folder();
    callback open-log();
    callback download-ffmpeg();
    callback lhm-port-edited(string);
    callback open-url(string);
    callback autostart-toggled(bool);
    callback show-tray-toggled(bool);
    callback login-toggled(bool);
    callback toggle-display();

    HorizontalLayout {
        // ---- Sidebar -----------------------------------------------------------------------
        Rectangle {
            width: 236px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                HorizontalLayout {
                    padding-top: 8px;
                    padding-bottom: 20px;
                    padding-left: 6px;
                    spacing: 10px;
                    Image {
                        source: root.app-icon;
                        width: 30px;
                        height: 30px;
                    }
                    Text {
                        text: "AIO Cooler Screen";
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: Palette.foreground;
                    }
                }
                NavItem {
                    glyph: "\u{EB9F}";
                    text: root.language == 1 ? ("Arka plan") : ("Background");
                    selected: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    glyph: "\u{E790}";
                    text: root.language == 1 ? ("Tasarım") : ("Design");
                    selected: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    glyph: "\u{E9D9}";
                    text: root.language == 1 ? ("Sensörler") : ("Sensors");
                    selected: root.page == 2;
                    clicked => { root.page = 2; }
                }
                NavItem {
                    glyph: "\u{E713}";
                    text: root.language == 1 ? ("Ayarlar") : ("Settings");
                    selected: root.page == 3;
                    clicked => { root.page = 3; }
                }
                Rectangle { vertical-stretch: 1; }
                NavItem {
                    glyph: "\u{E7E8}";
                    text: root.language == 1 ? (root.display-off ? "Ekranı aç" : "Ekranı kapat") : (root.display-off ? "Turn on display" : "Turn off display");
                    clicked => { root.toggle-display(); }
                }
                Rectangle {
                    border-radius: 6px;
                    background: #80808014;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.display-off ? #808080 : root.cooler-ok ? #22c55e : #f59e0b;
                            }
                        }
                        Text {
                            text: root.language == 1 ? (root.display-off ? "Ekran kapalı" : root.cooler-state) : (root.display-off ? "Display off" : root.cooler-state);
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        // ---- Content -----------------------------------------------------------------------
        Rectangle {
            horizontal-stretch: 1;

            // Background and Design share the layout: settings on the left, preview on the right.
            if root.page == 0 || root.page == 1: HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding: 28px;
                padding-right: 24px;
                spacing: 24px;

                // ---- Background page ----
                if root.page == 0: ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 16px;
                        padding-right: 12px;
                        alignment: start;
                        PageHeader {
                            title: root.language == 1 ? ("Arka plan") : ("Background");
                            subtitle: root.language == 1 ? ("İstatistiklerin arkasında gösterilecek görüntü.") : ("What the screen shows behind your stats.");
                        }
                        Card {
                            title: root.language == 1 ? ("Hazır arka planlar") : ("Built-in backgrounds");
                            subtitle: root.language == 1 ? ("Ekrana uygulamak için birini seç.") : ("Click one to put it on the screen.");
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for thumb[i] in root.bg-thumbs: RoundTile {
                                    thumb: thumb;
                                    name: root.bg-names[i];
                                    selected: root.bg-selected == i;
                                    clicked => { root.builtin-background(i); }
                                }
                            }
                        }
                        Card {
                            title: root.language == 1 ? ("Görselin veya videon") : ("Your image or video");
                            subtitle: root.language == 1 ? ("PNG, JPG, BMP, WebP görselleri; MP4/MOV/MKV/WebM/AVI/WMV videoları ve hareketli GIF dosyaları.") : ("PNG, JPG, BMP, WebP, or MP4/MOV/MKV/WebM/AVI/WMV videos and animated GIFs.");
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: #80808014;
                                    border-width: 1px;
                                    border-color: #80808030;
                                    min-height: 32px;
                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        text: root.language == 1 ? (root.source-path == "" ? "Dosya seç…" : root.source-path) : (root.source-path == "" ? "Choose a file…" : root.source-path);
                                        opacity: root.source-path == "" ? 0.6 : 1;
                                        color: Palette.foreground;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                Button {
                                    text: root.language == 1 ? ("Gözat…") : ("Browse…");
                                    clicked => { root.browse(); }
                                }
                            }
                            if root.source-is-video && !root.ffmpeg-ok: InfoBar {
                                warning: true;
                                text: root.language == 1 ? (root.ffmpeg-busy ? "ffmpeg indiriliyor…" : "Videolar için ffmpeg gerekiyor; henüz kurulu değil.") : (root.ffmpeg-busy ? "Downloading ffmpeg…" : "Videos need ffmpeg, which isn't installed yet.");
                                if !root.ffmpeg-busy: Button {
                                    text: root.language == 1 ? ("ffmpeg indir") : ("Download ffmpeg");
                                    clicked => { root.download-ffmpeg(); }
                                }
                            }
                            SettingRow {
                                label: root.language == 1 ? "Sığdır" : "Fit";
                                ComboBox {
                                    width: 220px;
                                    model: root.language == 1 ? ["Dolduracak şekilde kırp", "Sığdır (siyah kenarlar)", "Esnet"] : ["Crop to fill", "Fit inside (black bars)", "Stretch"];
                                    current-index <=> root.fit;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: end;
                                if root.busy: Spinner {
                                    width: 22px;
                                    height: 22px;
                                    indeterminate: true;
                                }
                                if root.busy: Text {
                                    text: root.busy-text;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }
                                Button {
                                    text: root.language == 1 ? ("Ekrana uygula") : ("Apply to screen");
                                    primary: true;
                                    enabled: !root.busy && root.source-path != "" && (root.ffmpeg-ok || !root.source-is-video);
                                    clicked => { root.apply-media(); }
                                }
                            }
                        }
                        if root.message != "": InfoBar {
                            text: root.message;
                            ok: root.message-ok;
                        }
                    }
                }

                // ---- Design page ----
                if root.page == 1: ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 16px;
                        padding-right: 12px;
                        alignment: start;
                        PageHeader {
                            title: root.language == 1 ? ("Tasarım") : ("Design");
                            subtitle: root.language == 1 ? ("Canlı verilerin arka plan üzerinde görünümü. Her tasarımın ayarları ayrıdır.") : ("How live stats are drawn on top of the background. Each design keeps its own settings.");
                        }
                        Card {
                            SettingRow {
                                label: root.language == 1 ? "Canlı verileri göster" : "Show live stats";
                                hint: root.language == 1 ? "Yalnızca arka planı göstermek için kapat." : "Turn off to show only the background.";
                                Switch {
                                    checked <=> root.stats-enabled;
                                    toggled => { root.settings-changed(); }
                                }
                            }
                        }
                        Card {
                            title: root.language == 1 ? ("Tasarımlar") : ("Designs");
                            ScrollView {
                                height: 168px;
                                content-width: gallery.preferred-width;
                                content-height: 160px;
                                gallery := HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    for thumb[i] in root.design-thumbs: RoundTile {
                                        thumb: thumb;
                                        name: root.design-names[i];
                                        selected: root.design == i && root.stats-enabled;
                                        clicked => { root.design-selected(i); }
                                    }
                                    NewDesignTile {
                                        language: root.language;
                                        clicked => { root.new-design(); }
                                    }
                                }
                            }
                        }

                        // Options of the selected built-in design, or the editor for a custom one.
                        Card {
                            title: root.language == 1 ? (root.design >= 4 ? "Düzenle: " + root.design-names[root.design] : root.design-names[root.design] + " seçenekleri") : (root.design >= 4 ? "Edit " + root.design-names[root.design] : root.design-names[root.design] + " options");
                            subtitle: root.language == 1 ? (root.design >= 4 ? "Bileşen ekle, düzenlemek için seç ve önizlemede sürükleyerek taşı." : "") : (root.design >= 4 ? "Add widgets, pick one to change it, and drag widgets in the preview to move them." : "");

                            if root.design >= 4: VerticalLayout {
                                spacing: 12px;
                                SettingRow {
                                    label: root.language == 1 ? "Ad" : "Name";
                                    LineEdit {
                                        width: 240px;
                                        text <=> root.custom-name;
                                        edited => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "24 saat biçimi" : "24-hour time";
                                    hint: root.language == 1 ? "Kapatıldığında saat bileşenlerinde AM/PM gösterilir." : "Off shows AM/PM in time widgets.";
                                    Switch {
                                        checked <=> root.cu-h24;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ComboBox {
                                        width: 170px;
                                        model: root.widget-kinds;
                                        current-index <=> root.add-kind;
                                    }
                                    Button {
                                        text: root.language == 1 ? ("Bileşen ekle") : ("Add widget");
                                        clicked => { root.add-widget(root.add-kind); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button {
                                        text: root.language == 1 ? ("Kopyala") : ("Duplicate");
                                        clicked => { root.duplicate-design(); }
                                    }
                                    Button {
                                        text: root.language == 1 ? ("Tasarımı sil") : ("Delete design");
                                        clicked => { root.delete-design(); }
                                    }
                                }
                                Rectangle {
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #80808030;
                                    VerticalLayout {
                                        padding: 4px;
                                        for name[i] in root.widget-names: Rectangle {
                                            height: 32px;
                                            border-radius: 4px;
                                            background: root.selected-widget == i ? #8080802a : wta.has-hover ? #80808014 : transparent;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                spacing: 8px;
                                                Rectangle {
                                                    width: 3px;
                                                    height: 16px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 1.5px;
                                                    background: root.selected-widget == i ? Palette.accent-background : transparent;
                                                }
                                                Text {
                                                    text: name;
                                                    font-size: 13px;
                                                    vertical-alignment: center;
                                                    color: Palette.foreground;
                                                }
                                            }
                                            wta := TouchArea { clicked => { root.widget-selected(i); } }
                                        }
                                        if root.widget-names.length == 0: Text {
                                            text: root.language == 1 ? ("Henüz bileşen yok. Yukarıdan ekleyebilirsin.") : ("No widgets yet. Add one above.");
                                            opacity: 0.6;
                                            font-size: 12px;
                                            color: Palette.foreground;
                                        }
                                    }
                                }
                                if root.selected-widget >= 0: VerticalLayout {
                                    spacing: 12px;
                                    Divider { }
                                    Text {
                                        text: root.w-kind-name;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Palette.foreground;
                                    }
                                    if root.w-uses-stat: SettingRow {
                                        label: root.language == 1 ? "Sensör" : "Sensor";
                                        hint: root.language == 1 ? "Fan/pompa (RPM), sıcaklık, güç, voltaj, frekans ve daha fazlası. Türe göre sıralanır." : "Fan/pump (RPM), temperature, power, voltage, clocks and more. Sorted by type.";
                                        ComboBox {
                                            width: 320px;
                                            model: root.widget-sensor-choices;
                                            current-index <=> root.w-stat;
                                            selected => { root.widget-changed(); }
                                        }
                                    }
                                    if root.w-uses-stat: SettingRow {
                                        label: root.language == 1 ? "Gösterge üst sınırı" : "Gauge maximum";
                                        hint: root.language == 1 ? "Doğrudan sensör halkaları/çubukları için (RPM, W, V, MHz vb.)." : "Only for direct sensor rings/bars (RPM, W, V, MHz etc.).";
                                        Slider {
                                            width: 220px;
                                            minimum: 1;
                                            maximum: 10000;
                                            value <=> root.w-sensor-max;
                                            changed => { root.widget-changed(); }
                                        }
                                    }
                                    if root.w-is-label: SettingRow {
                                        label: root.language == 1 ? "Metin" : "Text";
                                        LineEdit {
                                            width: 240px;
                                            text <=> root.w-text;
                                            edited => { root.widget-changed(); }
                                        }
                                    }
                                    SettingRow {
                                        label: root.w-size-label;
                                        hint: Math.round(root.w-size) + " px";
                                        Slider {
                                            width: 220px;
                                            minimum: root.w-size-min;
                                            maximum: root.w-size-max;
                                            value <=> root.w-size;
                                            changed => { root.widget-changed(); }
                                        }
                                    }
                                    if root.w-has-thickness: SettingRow {
                                        label: root.language == 1 ? "Kalınlık" : "Thickness";
                                        hint: Math.round(root.w-thickness) + " px";
                                        Slider {
                                            width: 220px;
                                            minimum: 2;
                                            maximum: 40;
                                            value <=> root.w-thickness;
                                            changed => { root.widget-changed(); }
                                        }
                                    }
                                    SettingRow {
                                        label: root.language == 1 ? "Konum" : "Position";
                                        hint: "x " + Math.round(root.w-x) + ", y " + Math.round(root.w-y) + (root.language == 1 ? " (veya önizlemede sürükle)" : " (or drag in the preview)");
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Slider {
                                                width: 140px;
                                                minimum: 0;
                                                maximum: 480;
                                                value <=> root.w-x;
                                                changed => { root.widget-changed(); }
                                            }
                                            Slider {
                                                width: 140px;
                                                minimum: 0;
                                                maximum: 480;
                                                value <=> root.w-y;
                                                changed => { root.widget-changed(); }
                                            }
                                        }
                                    }
                                    if root.w-is-text: SettingRow {
                                        label: root.language == 1 ? "Kalın yazı" : "Bold";
                                        Switch {
                                            checked <=> root.w-bold;
                                            toggled => { root.widget-changed(); }
                                        }
                                    }
                                    SettingRow {
                                        label: root.language == 1 ? "Tasarım renklerini kullan" : "Use design colours";
                                        hint: root.language == 1 ? "Metinler için yazı rengi; göstergeler için sıcaklık veya vurgu rengi." : "Text colour for text; temperature or accent colour for gauges.";
                                        Switch {
                                            checked <=> root.w-auto;
                                            toggled => { root.widget-changed(); }
                                        }
                                    }
                                    if !root.w-auto: SettingRow {
                                        label: root.language == 1 ? "Renk" : "Color";
                                        Swatches {
                                            colors: root.swatches;
                                            selected <=> root.w-color-index;
                                            picked => { root.widget-changed(); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Button {
                                            text: root.language == 1 ? ("Öne getir") : ("Bring forward");
                                            clicked => { root.move-widget(1); }
                                        }
                                        Button {
                                            text: root.language == 1 ? ("Arkaya gönder") : ("Send backward");
                                            clicked => { root.move-widget(-1); }
                                        }
                                        Button {
                                            text: root.language == 1 ? ("Bileşeni sil") : ("Delete widget");
                                            clicked => { root.delete-widget(); }
                                        }
                                    }
                                }
                            }

                            if root.design == 0: VerticalLayout {
                                spacing: 12px;
                                SettingRow {
                                    label: root.language == 1 ? "Yük halkaları" : "Load rings";
                                    hint: root.language == 1 ? "CPU ve GPU kullanımı için ince iç halkalar." : "Thin inner rings for CPU and GPU load.";
                                    Switch {
                                        checked <=> root.g-load-rings;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "Etiketler" : "Labels";
                                    hint: root.language == 1 ? "CPU/GPU başlıkları ve kullanım metinleri." : "CPU / GPU titles and load text.";
                                    Switch {
                                        checked <=> root.g-labels;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "Halka kalınlığı" : "Ring thickness";
                                    hint: Math.round(root.g-thickness) + " px";
                                    Slider {
                                        width: 220px;
                                        minimum: 8;
                                        maximum: 36;
                                        value <=> root.g-thickness;
                                        released => { root.settings-changed(); }
                                    }
                                }
                            }

                            if root.design == 1: VerticalLayout {
                                spacing: 12px;
                                SettingRow {
                                    label: root.language == 1 ? "Kutucuklar" : "Tiles";
                                    HorizontalLayout {
                                        spacing: 12px;
                                        CheckBox {
                                            text: root.language == 1 ? ("CPU sıcaklığı") : ("CPU temp");
                                            checked <=> root.t-cpu-temp;
                                            toggled => { root.settings-changed(); }
                                        }
                                        CheckBox {
                                            text: root.language == 1 ? ("CPU kullanımı") : ("CPU load");
                                            checked <=> root.t-cpu-load;
                                            toggled => { root.settings-changed(); }
                                        }
                                        CheckBox {
                                            text: root.language == 1 ? ("GPU sıcaklığı") : ("GPU temp");
                                            checked <=> root.t-gpu-temp;
                                            toggled => { root.settings-changed(); }
                                        }
                                        CheckBox {
                                            text: root.language == 1 ? ("GPU kullanımı") : ("GPU load");
                                            checked <=> root.t-gpu-load;
                                            toggled => { root.settings-changed(); }
                                        }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "Yerleşim" : "Layout";
                                    ComboBox {
                                        width: 160px;
                                        model: root.language == 1 ? ["Tek sütun", "İki sütun"] : ["One column", "Two columns"];
                                        current-index <=> root.t-columns;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "Konum" : "Position";
                                    ComboBox {
                                        width: 160px;
                                        model: root.language == 1 ? ["Üst", "Orta", "Alt"] : ["Top", "Center", "Bottom"];
                                        current-index <=> root.t-position;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "Kutucukların arkasında paneller" : "Panels behind tiles";
                                    Switch {
                                        checked <=> root.t-panel;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                if root.t-panel: SettingRow {
                                    label: root.language == 1 ? "Panel saydamlığı" : "Panel opacity";
                                    hint: Math.round(root.t-panel-opacity) + "%";
                                    Slider {
                                        width: 220px;
                                        minimum: 10;
                                        maximum: 100;
                                        value <=> root.t-panel-opacity;
                                        released => { root.settings-changed(); }
                                    }
                                }
                            }

                            if root.design == 2: VerticalLayout {
                                spacing: 12px;
                                SettingRow {
                                    label: root.language == 1 ? "Gösterilecek değer" : "Stat to show";
                                    ComboBox {
                                        width: 200px;
                                        model: root.language == 1 ? (["CPU sıcaklığı", "CPU kullanımı", "GPU sıcaklığı", "GPU kullanımı"]) : (["CPU temperature", "CPU load", "GPU temperature", "GPU load"]);
                                        current-index <=> root.b-stat;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "İlerleme halkası" : "Progress ring";
                                    Switch {
                                        checked <=> root.b-ring;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "İşaret çizgileri" : "Tick marks";
                                    Switch {
                                        checked <=> root.b-ticks;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "İkinci satır" : "Second line";
                                    hint: root.language == 1 ? "İlgili kullanım veya sıcaklık değerini altında gösterir." : "Shows the related load or temperature underneath.";
                                    Switch {
                                        checked <=> root.b-secondary;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                            }

                            if root.design == 3: VerticalLayout {
                                spacing: 12px;
                                SettingRow {
                                    label: root.language == 1 ? "24 saatlik saat" : "24-hour clock";
                                    hint: root.language == 1 ? "Kapatıldığında AM/PM gösterilir." : "Off shows AM/PM.";
                                    Switch {
                                        checked <=> root.c-h24;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "Saniye halkası" : "Seconds ring";
                                    Switch {
                                        checked <=> root.c-seconds;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "Tarih" : "Date";
                                    Switch {
                                        checked <=> root.c-date;
                                        toggled => { root.settings-changed(); }
                                    }
                                }
                                SettingRow {
                                    label: root.language == 1 ? "Saatin altında istatistikler" : "Stats under the clock";
                                    ComboBox {
                                        width: 200px;
                                        model: root.language == 1 ? ["Sıcaklıklar", "Kullanım oranları", "Yok"] : ["Temperatures", "Loads", "None"];
                                        current-index <=> root.c-stats;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                            }
                        }

                        Card {
                            title: root.language == 1 ? ("Görünüm") : ("Style");
                            subtitle: root.language == 1 ? ("Metin ve renkler: " + root.design-names[root.design] + ".") : ("Text and colours of " + root.design-names[root.design] + ".");
                            SettingRow {
                                label: root.language == 1 ? "Yazı tipi" : "Font";
                                ComboBox {
                                    width: 200px;
                                    model: ["Segoe UI", "Bahnschrift", "Arial", "Consolas", "Google Sans", "Google Sans Flex", "Inter", "Rajdhani", "Orbitron", "JetBrains Mono", "Roboto Condensed", "Oswald"];
                                    current-index <=> root.font-index;
                                    selected => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                label: root.language == 1 ? "Yazı boyutu" : "Text size";
                                hint: Math.round(root.text-scale) + "%";
                                Slider {
                                    width: 220px;
                                    minimum: 70;
                                    maximum: 130;
                                    value <=> root.text-scale;
                                    released => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                label: root.language == 1 ? "Metin kenarlığı" : "Text outline";
                                hint: root.language == 1 ? "Açık renkli arka planlarda okunabilirlik için koyu metin kenarlığı." : "A dark edge so text reads well on bright backgrounds.";
                                Switch {
                                    checked <=> root.outline;
                                    toggled => { root.settings-changed(); }
                                }
                            }
                            Divider { }
                            SettingRow {
                                label: root.language == 1 ? "Metin rengi" : "Text colour";
                                Swatches {
                                    colors: root.swatches;
                                    selected <=> root.text-color-index;
                                    picked => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                label: root.language == 1 ? "Vurgu rengi" : "Accent colour";
                                hint: root.language == 1 ? "Halkalar, çubuklar ve vurgular." : "Rings, bars and highlights.";
                                Swatches {
                                    colors: root.swatches;
                                    selected <=> root.accent-index;
                                    picked => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                label: root.language == 1 ? "Sıcaklıklara göre renklendir" : "Colour temperatures";
                                hint: root.language == 1 ? "Soğukken mavi, ardından yeşil ve sarı; sıcakken kırmızı." : "Blue when cool through green and amber to red when hot.";
                                Switch {
                                    checked <=> root.temp-colors;
                                    toggled => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                label: root.language == 1 ? "Arka planı karart" : "Darken background";
                                hint: Math.round(root.dim) + "%";
                                Slider {
                                    width: 220px;
                                    minimum: 0;
                                    maximum: 80;
                                    value <=> root.dim;
                                    released => { root.settings-changed(); }
                                }
                            }
                        }
                    }
                }

                // ---- Preview panel ----
                VerticalLayout {
                    width: 348px;
                    alignment: start;
                    spacing: 16px;
                    Card {
                        title: root.language == 1 ? ("Önizleme") : ("Preview");
                        subtitle: root.design >= 4 && root.page == 1 && root.stats-enabled
                            ? (root.language == 1 ? "Seçmek için bileşene tıkla, taşımak için sürükle." : "Click a widget to select it, drag to move it.")
                            : root.preview-live ? (root.language == 1 ? "Hizmetten gelen canlı değerler." : "Live values from the service.") : (root.language == 1 ? "Sensörlerden veri gelene kadar örnek değerler." : "Sample values until sensors report.");
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: root.language == 1 ? "Ekran şekli:" : "Screen shape:";
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                width: 145px;
                                model: root.language == 1 ? ["Kare", "Yuvarlak"] : ["Square", "Round"];
                                current-index <=> root.preview-shape;
                                selected => { root.preview-shape-changed(self.current-index); }
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 300px;
                                height: 300px;
                                border-radius: root.preview-shape == 1 ? 150px : 0px;
                                clip: true;
                                background: #000000;
                                Image {
                                    source: root.preview;
                                    width: 300px;
                                    height: 300px;
                                }
                                // Custom designs: click a widget to select it, drag to move it.
                                TouchArea {
                                    enabled: root.design >= 4 && root.page == 1;
                                    mouse-cursor: self.enabled ? MouseCursor.move : MouseCursor.default;
                                    pointer-event(ev) => {
                                        if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                                            root.preview-pressed(self.mouse-x / 1px, self.mouse-y / 1px);
                                        }
                                        if ev.kind == PointerEventKind.up {
                                            root.preview-released();
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.preview-dragged(self.mouse-x / 1px, self.mouse-y / 1px);
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            InfoLine {
                                glyph: "\u{EB9F}";
                                text: root.media-name;
                            }
                            InfoLine {
                                glyph: "\u{E790}";
                                text: root.language == 1 ? (root.stats-enabled ? root.design-names[root.design] : "İstatistik yok") : (root.stats-enabled ? root.design-names[root.design] : "No stats");
                            }
                        }
                    }
                    if !root.sensors-ok: InfoBar {
                        warning: true;
                        text: root.language == 1 ? ("Henüz sensör verisi yok. Sensörler sayfasını kontrol et.") : ("No sensor data yet. See the Sensors page.");
                    }
                    if root.official-running: InfoBar {
                        warning: true;
                        text: root.language == 1 ? ("Resmî Monster uygulaması açık. Ekran çakışmasını önlemek için kapat.") : ("The official Monster app is running. Close it so it doesn't fight over the screen.");
                    }
                }
            }

            // ---- Sensors page ----
            if root.page == 2: ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    alignment: start;
                    PageHeader {
                        title: root.language == 1 ? ("Sensörler") : ("Sensors");
                        subtitle: root.language == 1 ? ("Değerlerin alındığı kaynaklar. Otomatik seçim CPU paket sıcaklığını ve haricî GPU'yu kullanır.") : ("Where each stat comes from. Auto picks the CPU package temperature and your discrete GPU.");
                    }
                    Card {
                        title: root.language == 1 ? ("İstatistikler") : ("Stats");
                        for row[i] in root.stat-rows: VerticalLayout {
                            spacing: 10px;
                            if i > 0: Divider { }
                            HorizontalLayout {
                                spacing: 16px;
                                Text {
                                    width: 150px;
                                    text: row.title;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: row.choices;
                                    current-index: row.index;
                                    selected => { root.source-selected(i, self.current-index); }
                                }
                                Text {
                                    width: 70px;
                                    text: row.value;
                                    font-size: 20px;
                                    font-weight: 600;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }
                            }
                        }
                    }
                    Card {
                        title: root.language == 1 ? ("Kaynaklar") : ("Sources");
                        subtitle: root.language == 1 ? ("CPU sıcaklığı ve kullanımı doğrudan okunur. Dahili LHM ek donanım sensörlerini sağlar; HWiNFO ve harici LibreHardwareMonitor isteğe bağlıdır.") : ("CPU temperature and load are read directly. Internal LHM provides additional hardware sensors; HWiNFO and external LibreHardwareMonitor remain optional.");
                        Text {
                            text: root.sensors-state;
                            color: Palette.foreground;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Divider { }
                        Text {
                            text: root.language == 1 ? ("Dahili LHM: Kurulum paketiyle birlikte gelir; ayrı LibreHardwareMonitor uygulaması veya web sunucusu gerekmez. Bazı donanımlar desteklenmeyebilir.\nİsteğe bağlı alternatifler:\nHWiNFO: Ayarlardan \"Shared Memory Support\" seçeneğini açıp HWiNFO uygulamasını çalışır bırak. Ücretsiz sürümde bu özellik 12 saat sonra kapanır.\nHarici LibreHardwareMonitor: yönetici olarak aç ve Options > Remote Web Server > Run seçeneğini etkinleştir. Aşağıdaki port ayarını kullan.") : ("Internal LHM: bundled with the installer; no separate LibreHardwareMonitor app or web server needed. Some hardware may be unsupported.\nOptional alternatives:\nHWiNFO: open Settings, enable \"Shared Memory Support\" and keep HWiNFO running. The free version turns this off after 12 hours.\nExternal LibreHardwareMonitor: run as administrator and enable Options > Remote Web Server > Run. Configure the port below.");
                            color: Palette.foreground;
                            opacity: 0.75;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button {
                                text: root.language == 1 ? ("HWiNFO indir") : ("Get HWiNFO");
                                clicked => { root.open-url("https://www.hwinfo.com/download/"); }
                            }
                            Button {
                                text: root.language == 1 ? ("LibreHardwareMonitor indir") : ("Get LibreHardwareMonitor");
                                clicked => { root.open-url("https://github.com/LibreHardwareMonitor/LibreHardwareMonitor/releases"); }
                            }
                        }
                        SettingRow {
                            label: root.language == 1 ? "Harici LibreHardwareMonitor web sunucusu portu" : "External LibreHardwareMonitor web server port";
                            LineEdit {
                                width: 100px;
                                text <=> root.lhm-port;
                                input-type: number;
                                edited(t) => { root.lhm-port-edited(t); }
                            }
                        }
                    }
                }
            }

            // ---- Settings page ----
            if root.page == 3: ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    alignment: start;
                    PageHeader { title: root.language == 1 ? "Ayarlar" : "Settings"; }
                    Card {
                        title: root.language == 1 ? "Dil / Language" : "Language / Dil";
                        subtitle: root.language == 1 ? "Arayüz dilini seçin. Seçiminiz kaydedilir." : "Choose the interface language. Your choice is saved.";
                        SettingRow {
                            label: root.language == 1 ? "Arayüz dili" : "Interface language";
                            ComboBox {
                                width: 220px;
                                model: ["English", "Türkçe"];
                                current-index <=> root.language;
                                selected => { root.language-changed(self.current-index); }
                            }
                        }
                    }

                    if root.official-running: InfoBar {
                        warning: true;
                        text: root.language == 1 ? ("Resmî Monster uygulaması açık. Ekran çakışmasını önlemek için kapat.") : ("The official Monster app is running. Close it so it doesn't fight over the screen.");
                    }
                    Card {
                        title: root.language == 1 ? ("Arka plan hizmeti") : ("Background service");
                        subtitle: root.language == 1 ? ("Windows ile başlar, soğutucuyla iletişim kurar ve ekranı açık tutar.") : ("Starts with Windows, talks to the cooler and keeps the screen awake.");
                        SettingRow {
                            label: root.language == 1 ? "Durum" : "Status";
                            Text {
                                text: root.service-state;
                                color: root.service-running ? #22c55e : #f59e0b;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        SettingRow {
                            label: root.language == 1 ? "Soğutucu" : "Cooler";
                            Text {
                                text: root.cooler-state;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                        }
                        if root.last-error != "": InfoBar { text: (root.language == 1 ? "Son hata: " : "Last error: ") + root.last-error; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button {
                                text: root.language == 1 ? ("Hizmeti yeniden başlat") : ("Restart service");
                                clicked => { root.repair-service(); }
                            }
                            Button {
                                text: root.language == 1 ? ("Günlüğü aç") : ("Open log");
                                clicked => { root.open-log(); }
                            }
                            Button {
                                text: root.language == 1 ? ("Veri klasörünü aç") : ("Open data folder");
                                clicked => { root.open-data-folder(); }
                            }
                        }
                    }
                    Card {
                        title: root.language == 1 ? ("Başlangıç") : ("Startup");
                        SettingRow {
                            label: root.language == 1 ? "Windows ile başlat" : "Start with Windows";
                            hint: root.language == 1 ? ("Tasarımını oturum açmadan önce ekrana uygular. Değişiklik yönetici izni ister.") : ("Puts your design on the cooler right after boot, before you sign in. Changing it asks for admin rights.");
                            HorizontalLayout {
                                spacing: 10px;
                                if root.autostart-busy: Spinner {
                                    width: 20px;
                                    height: 20px;
                                    indeterminate: true;
                                }
                                Switch {
                                    enabled: !root.autostart-busy;
                                    checked <=> root.autostart;
                                    toggled => { root.autostart-toggled(self.checked); }
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            label: root.language == 1 ? "Sistem tepsisinde simge göster" : "Show icon in system tray";
                            hint: root.language == 1 ? ("Pencere kapansa da uygulama tepside çalışır. Pencere kapatılınca çıkmak için devre dışı bırak.") : ("Closing the window keeps the app in the tray. Turn off to quit when the window closes.");
                            Switch {
                                checked <=> root.show-tray;
                                toggled => { root.show-tray-toggled(self.checked); }
                            }
                        }
                        SettingRow {
                            label: root.language == 1 ? "Oturum açınca tepside başlat" : "Open in tray at login";
                            hint: root.language == 1 ? (root.show-tray ? "Yalnızca tepsi simgesi görünür; pencereyi açmak için tıkla." : "Tepsi simgesi gerekli.") : (root.show-tray ? "Only the tray icon appears; click it to open this window." : "Needs the tray icon.");
                            Switch {
                                enabled: root.show-tray;
                                checked <=> root.login-tray;
                                toggled => { root.login-toggled(self.checked); }
                            }
                        }
                    }
                    Card {
                        title: root.language == 1 ? ("Video desteği") : ("Video support");
                        subtitle: root.language == 1 ? ("ffmpeg yalnızca video ve GIF arka planları için gerekir; sistem PATH ayarını değiştirmez.") : ("ffmpeg is needed only for video and GIF backgrounds. It's kept private to this app and doesn't change PATH.");
                        SettingRow {
                            label: "ffmpeg";
                            Text {
                                text: root.ffmpeg-state;
                                color: root.ffmpeg-ok ? #22c55e : Palette.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 520px;
                            }
                        }
                        if root.ffmpeg-busy: ProgressIndicator {
                            height: 6px;
                            progress: root.ffmpeg-progress;
                        }
                        if !root.ffmpeg-ok && !root.ffmpeg-busy: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: root.language == 1 ? ("ffmpeg indir (yaklaşık 90 MB)") : ("Download ffmpeg (about 90 MB)");
                                primary: true;
                                clicked => { root.download-ffmpeg(); }
                            }
                        }
                    }
                    Card {
                        title: root.language == 1 ? ("Hakkında") : ("About");
                        subtitle: root.language == 1 ? ("AIO Cooler Screen " + root.version + ". Monster ile bağlantılı değildir.") : ("AIO Cooler Screen " + root.version + ". Not affiliated with Monster.");
                        Text {
                            wrap: word-wrap;
                            color: Palette.foreground;
                            font-size: 13px;
                            text: root.language == 1 ? ("Monster AIO Cooler LCD için arka planlar ve canlı istatistikler. CPU sıcaklığı açık kaynak PawnIO sürücüsünden, CPU kullanımı Windows'tan ve NVIDIA GPU değerleri NVML üzerinden okunur. Dahili LHM ek sensörleri ayrı web sunucusu olmadan okur; HWiNFO ve harici LibreHardwareMonitor alternatif olarak desteklenir. Videolar ffmpeg ile dönüştürülür. Ayrıntılar kurulum klasöründeki THIRD-PARTY-NOTICES.md dosyasında.") : ("Backgrounds and live stats for the Monster AIO Cooler LCD. CPU temperatures are read through the open-source PawnIO driver, CPU load from Windows and NVIDIA GPUs through the driver's NVML; Internal LHM reads additional sensors without a separate web server; HWiNFO and external LibreHardwareMonitor remain supported alternatives. Videos are converted with ffmpeg. See THIRD-PARTY-NOTICES.md in the install folder.");
                        }
                        HorizontalLayout {
                            alignment: start;
                            AboutSlint {
                                width: 240px;
                                height: 130px;
                            }
                        }
                    }
                }
            }
        }
    }
}
